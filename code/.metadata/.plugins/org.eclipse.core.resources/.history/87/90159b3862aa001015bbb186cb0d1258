  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */
  HAL_TIM_Base_Start_IT (& htim2 );

  setTimer0(10);
  setTimerFPS(100);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  if (timer0_flag == 1)
	  {
		  setTimer0(10);
		  fsm_for_input_processing ();
		  if (mode > 4)
		  {
			  mode = 1;
		  }
		  switch(mode)
		  {
		  case 1:

			  break;
		  case 2:
			  displaySEGB(mode);
			  break;
		  case 3:
			  displaySEGB(mode);
			  break;
		  case 4:
			  displaySEGB(mode);
			  break;
		  default:
			  break;
		  }
	  }

	  if (timerFPS_flag == 1)
	  {
		  setTimerFPS(100);
		  switch (mode)
		  {
		  case 1:
			  break;
		  case 2:
			  displayWhatSEG(redTime);
			  displayWhichSEG(ledIndex);
			  displaySEGA(timeSEG[ledIndex]);
			  break;
		  case 3:
			  displayWhichSEG(ledIndex);
			  break;
		  case 4:
			  displayWhichSEG(ledIndex);
			  break;
		  default:
			  break;
		  }

		  ledIndex++;
		  if (ledIndex > 1)
			  ledIndex = 0;
	  }
  }
  /* USER CODE END 3 */
}

